# ================================================================
# DevOps Portfolio - Git Ignore Rules
# This file specifies files and directories that should not be
# tracked by Git and should not be pushed to GitHub
# ================================================================

# ================================================================
# 1. OPERATING SYSTEM FILES
# Files generated by different operating systems
# ================================================================

# Windows
Thumbs.db
Desktop.ini
.DS_Store
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
*.swp
*~
._*

# Linux
.directory
*~

# ================================================================
# 2. EDITOR & IDE FILES
# Configuration files from various code editors
# ================================================================

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
.gradle/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# Vim
.vim/
*.swp
*.swo
*~

# Emacs
*~
*#
.*#

# ================================================================
# 3. DEPENDENCY & PACKAGE MANAGER FILES
# Node.js and npm related files
# ================================================================

# Node.js
node_modules/
package-lock.json
npm-debug.log
npm-debug.log*
yarn-error.log*
yarn.lock

# pip and Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ================================================================
# 4. BUILD & COMPILE OUTPUT
# Files generated during build process
# ================================================================

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Build directories
build/
dist/
.build/
out/

# ================================================================
# 5. DEVELOPMENT & TEMPORARY FILES
# Temporary files created during development
# ================================================================

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~
.tmp

# Log files
*.log
logs/

# Environment files
.env
.env.local
.env.*.local

# ================================================================
# 6. DATABASE FILES
# Database and data files that shouldn't be in version control
# ================================================================

*.db
*.sqlite
*.sqlite3
*.db3
*.mdb
.ysql

# ================================================================
# 7. CACHE & TEMPORARY DIRECTORIES
# Cache and temporary directories
# ================================================================

.cache/
.temp/
tmp/
temp/
cache/

# ================================================================
# 8. SECURITY & SENSITIVE FILES
# Files containing sensitive information
# ================================================================

# Credentials and secrets
secrets/
.secrets
*.key
*.pem
*.p12
.aws/
.ssh/

# API keys and tokens
config.json
credentials.json
private/

# ================================================================
# 9. BACKUP FILES
# Backup copies that shouldn't be tracked
# ================================================================

*.backup
*.bak
*.old
*.orig
backup/

# ================================================================
# 10. SYSTEM FILES
# System-specific files
# ================================================================

# Windows system files
$RECYCLE.BIN/
ehthumbs.db

# ================================================================
# 11. DOCUMENTATION BUILD FILES
# Generated documentation files
# ================================================================

docs/_build/
site/

# ================================================================
# 12. ASSET FILES (OPTIONAL - Uncomment if needed)
# Large binary files that might be better stored separately
# ================================================================

# Uncomment these lines if you have large image files you don't want to track
# assets/images/*.jpg
# assets/images/*.png
# assets/videos/*.mp4

# ================================================================
# 13. OS-SPECIFIC DIRECTORIES
# Directories created by operating systems
# ================================================================

# Directory used by macOS for storing folder attributes
.DS_Store

# Spotlight directory
.Spotlight-V100

# Trash folder
.Trashes

# ================================================================
# 14. PRODUCTION DEPLOYMENT FILES
# Files specific to production deployments
# ================================================================

# SSL certificates
*.crt
*.cer
*.pfx

# Compressed/Archive files (optional)
# *.zip
# *.tar.gz
# *.rar

# ================================================================
# 15. NODE MODULES & DEPENDENCIES
# Large dependency folders
# ================================================================

node_modules/
bower_components/
jspm_packages/

# ================================================================
# 16. TYPESCRIPT
# TypeScript specific files
# ================================================================

*.tsbuildinfo
dist/

# ================================================================
# NOTE: Guidelines for updating .gitignore
#
# 1. Never commit sensitive data (passwords, API keys, tokens)
# 2. Exclude large binary files and dependencies
# 3. Exclude build outputs and temporary files
# 4. Review and update regularly as project evolves
# 5. Use comments to explain rules for future developers
#
# REMEMBER: .gitignore must be committed to repository!
# ================================================================
